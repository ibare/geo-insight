{
  "name": "@geo-insight/core",
  "version": "0.1.0",
  "type": "module",
  "description": "GeoInsight compiler — semantic geographic DSL to deterministic SVG (IR pipeline, framework-free).",
  "license": "MIT",
  "author": "ibare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibare/geo-insight.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ibare/geo-insight#readme",
  "bugs": "https://github.com/ibare/geo-insight/issues",
  "keywords": [
    "geoinsight",
    "geography",
    "map",
    "svg",
    "dsl",
    "compiler",
    "d3-geo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@geo-insight/data": "workspace:*",
    "d3-geo": "^3.1.1"
  },
  "optionalDependencies": {
    "d3-geo-projection": "^4.0.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
