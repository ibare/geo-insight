{
  "name": "@geo-insight/runtime",
  "version": "0.1.0",
  "type": "module",
  "description": "GeoInsight runtime — vanilla-DOM mount with zoom/pan for compiled geographic diagrams (framework-free).",
  "license": "MIT",
  "author": "ibare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibare/geo-insight.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/ibare/geo-insight#readme",
  "bugs": "https://github.com/ibare/geo-insight/issues",
  "keywords": [
    "geoinsight",
    "geography",
    "map",
    "svg",
    "zoom-pan",
    "vanilla-dom"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@geo-insight/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
