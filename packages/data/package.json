{
  "name": "@geo-insight/data",
  "version": "0.2.0",
  "type": "module",
  "description": "GeoInsight geometry + place-name resolver — world-atlas topology, ADM1 subdivisions, multilingual name resolution.",
  "license": "MIT",
  "author": "ibare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibare/geo-insight.git",
    "directory": "packages/data"
  },
  "homepage": "https://github.com/ibare/geo-insight#readme",
  "bugs": "https://github.com/ibare/geo-insight/issues",
  "keywords": [
    "geoinsight",
    "geography",
    "geodata",
    "topojson",
    "world-atlas",
    "adm1",
    "geometry"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "import": "./dist/src/node.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "import": "./dist/src/browser.js"
    },
    "./names": {
      "types": "./dist/src/names.d.ts",
      "import": "./dist/src/names.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/assets && cp -R assets/* dist/assets/ && mkdir -p dist/src/generated && cp src/generated/name-index.js src/generated/name-index.d.ts dist/src/generated/",
    "build:adm1": "node scripts/build-adm1.mjs",
    "build:names": "node scripts/build-name-index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "@types/topojson-client": "^3.1.5",
    "mapshaper": "^0.6.0",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
