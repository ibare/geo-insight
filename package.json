{
  "name": "geoinsight",
  "version": "0.1.0",
  "private": true,
  "description": "GeoInsight — 교육적 지리 설명을 위한 시맨틱 DSL → 결정적 SVG 렌더 엔진 (지도를 위한 Mermaid)",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "build:bundle": "pnpm --filter @geo-insight/tiptap run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter './packages/**' run typecheck",
    "release:check": "pnpm typecheck && pnpm test",
    "release:patch": "pnpm release:check && node scripts/release.mjs patch",
    "release:minor": "pnpm release:check && node scripts/release.mjs minor",
    "release:major": "pnpm release:check && node scripts/release.mjs major"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "happy-dom": "^15.11.0",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "electron"],
    "overrides": {
      "@tiptap/core": "3.26.0",
      "@tiptap/pm": "3.26.0"
    }
  }
}
